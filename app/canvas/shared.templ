package canvas

import (
	"gotth/app"
	"gotth/app/components"
)

templ SharedPage(title string, slug string, allowPublicEdits bool, meta app.PageMeta) {
	@app.CanvasLayout(title, meta) {
		<style>
			html, body { height: 100%; margin: 0; padding: 0; }
			body { overflow: hidden; display: flex; flex-direction: column; }
			#canvas-mount { width: 100%; flex: 1; min-height: 0; overflow: hidden; }
			#name-prompt {
				position: fixed; inset: 0; z-index: 9999;
				display: flex; align-items: center; justify-content: center;
				background: rgba(0,0,0,0.6);
			}
			#name-prompt.hidden { display: none; }
			.name-card {
				border: 2px solid var(--border);
				background: var(--bg);
				padding: 2rem;
				box-shadow: 4px 4px 0px 0px var(--border);
				width: 100%;
				max-width: 380px;
				margin: 0 1rem;
			}
			.name-card h2 {
				font-size: 0.875rem;
				font-weight: 700;
				text-transform: uppercase;
				letter-spacing: 0.1em;
				margin: 0 0 0.25rem;
			}
			.name-card p {
				font-size: 0.75rem;
				color: var(--fg-muted);
				margin: 0 0 1rem;
			}
			.name-card input {
				width: 100%;
				border: 2px solid var(--border);
				background: var(--bg-subtle);
				color: var(--fg);
				padding: 0.5rem 0.75rem;
				font-family: inherit;
				font-size: 0.875rem;
				margin-bottom: 0.75rem;
				box-sizing: border-box;
				outline: none;
			}
			.name-card input:focus { border-color: var(--accent); }
			.name-card button {
				width: 100%;
				padding: 0.5rem;
				font-size: 0.75rem;
				font-weight: 700;
				text-transform: uppercase;
				letter-spacing: 0.1em;
				cursor: pointer;
				border: 2px solid var(--border);
				background: var(--fg);
				color: var(--bg);
			}
			.name-card button:hover { opacity: 0.85; }
		</style>
		<header class="sticky top-0 z-50 w-full border-b-2 border-[var(--border)] bg-[var(--bg)]/95">
			<div class="mx-auto flex h-14 max-w-7xl items-center justify-between px-3 sm:px-6 lg:px-8">
				<div class="hidden sm:block">
					@components.Logo()
				</div>
				if allowPublicEdits {
					<span class="text-[10px] sm:text-xs font-bold uppercase tracking-wider text-[var(--accent)]">Live Collaboration</span>
				} else {
					<span class="text-[10px] sm:text-xs font-bold uppercase tracking-wider text-[var(--fg-muted)]">Read-only view</span>
				}
			</div>
		</header>
		if allowPublicEdits {
			<div id="name-prompt">
				<div class="name-card">
					<h2>Join Session</h2>
					<p>Enter your name so others know who's drawing.</p>
					<input id="username-input" type="text" placeholder="Your name" maxlength="32" autocomplete="off"/>
					<button onclick="joinSession()">Join →</button>
				</div>
			</div>
		}
		<div
			id="canvas-mount"
			data-slug={ slug }
			if allowPublicEdits {
				data-allow-public-edits="true"
			} else {
				data-allow-public-edits="false"
			}
		></div>
		<script src="/static/excalidraw.bundle.js"></script>
		@CanvasGuestScript()
	}
}
